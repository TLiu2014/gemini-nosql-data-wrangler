# MongoDB Atlas connection string (load sample_mflix dataset into this cluster)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority

# Google Gemini API key (for Multimodal Live API access)
GEMINI_API_KEY=

# Backend HTTP / WebSocket port (Cloud Run injects PORT automatically)
PORT=8080
