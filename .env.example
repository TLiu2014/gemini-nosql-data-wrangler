# MongoDB connection string. Two common shapes:
#   - Atlas:    mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
#   - Local:    mongodb://localhost:27017/         (see LOCAL_DEV.md for the
#                                                   `docker-compose` setup)
#
# This is the SERVER-SIDE default. Anything pasted into Settings →
# MongoDB Atlas Connection String in the UI overrides it per-session.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority

# Google Gemini API key (https://aistudio.google.com/apikey). As with the
# MongoDB URI, the UI's Settings → Gemini API Key overrides this.
GEMINI_API_KEY=

# Backend HTTP / WebSocket port. Cloud Run injects PORT automatically.
PORT=8080
